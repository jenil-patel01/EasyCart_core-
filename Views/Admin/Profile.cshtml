@model eays.Models.ApplicationUser

@{
    ViewData["Title"] = "Admin Profile";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="page-header">
    <div style="display: flex; gap: 15px; align-items: center;">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #7b1fa2, #512da8); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 26px; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
            @(string.IsNullOrEmpty(Model.FullName) ? "A" : Model.FullName.Substring(0, 1).ToUpper())
        </div>
        <div>
            <h2 style="margin: 0; font-weight: 700; color: #2d3436;">My Profile</h2>
            <p style="margin: 0; color: #636e72; font-size: 13px;">Manage your admin account details</p>
        </div>
    </div>
</div>

@if (TempData["ProfileMessage"] != null)
{
    <div style="background: #d4edda; color: #155724; padding: 15px 20px; border-radius: 10px; margin-bottom: 25px; display: flex; align-items: center; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
        <i class="fa fa-check-circle" style="margin-right: 10px; font-size: 20px;"></i>
        @TempData["ProfileMessage"]
    </div>
}

<div class="card-admin" style="width: 100%; max-width: 600px; padding: 35px; border-radius: 16px;">
    <form asp-action="UpdateProfile" method="post">
        
        <h4 style="margin-top: 0; margin-bottom: 25px; color: #2d3436; font-weight: 600; border-bottom: 2px solid #eee; padding-bottom: 15px;">
            <i class="fa fa-user" style="color: #7b1fa2; margin-right: 8px;"></i> Personal Information
        </h4>

        <div class="form-row">
            <label style="color: #636e72; font-size: 13px; text-transform: uppercase; letter-spacing: .5px;">Full Name</label>
            <input type="text" class="input-admin" style="padding: 12px; font-size: 15px;" name="FullName" value="@Model.FullName" required />
        </div>

        <div class="form-row">
            <label style="color: #636e72; font-size: 13px; text-transform: uppercase; letter-spacing: .5px;">Username</label>
            <input type="text" class="input-admin" style="padding: 12px; font-size: 15px; background: #f4f5f7; color: #b2bec3; cursor: not-allowed;" value="@Model.UserName" readonly />
        </div>

        <div class="form-row">
            <label style="color: #636e72; font-size: 13px; text-transform: uppercase; letter-spacing: .5px;">Email Address (Read-only)</label>
            <input type="email" class="input-admin" style="padding: 12px; font-size: 15px; background: #f4f5f7; color: #b2bec3; cursor: not-allowed;" value="@Model.Email" readonly />
        </div>

        <div class="form-row">
            <label style="color: #636e72; font-size: 13px; text-transform: uppercase; letter-spacing: .5px;">Phone Number</label>
            <input type="text" class="input-admin" style="padding: 12px; font-size: 15px;" name="PhoneNumber" value="@Model.PhoneNumber" />
        </div>

        <div class="form-row">
            <label style="color: #636e72; font-size: 13px; text-transform: uppercase; letter-spacing: .5px;">Address Information</label>
            <textarea class="input-admin" name="Address" style="padding: 12px; font-size: 15px; resize: vertical;" rows="4">@Model.Address</textarea>
        </div>

        <div class="form-actions" style="margin-top: 30px; display: flex; gap: 15px;">
            <button type="submit" class="btn-primary-admin" style="padding: 12px 30px; font-size: 15px; font-weight: 700; box-shadow: 0 4px 12px rgba(123, 31, 162, 0.3);">
                <i class="fa fa-save" style="margin-right: 6px;"></i> Save Changes
            </button>
            <a href="/Admin" class="btn-light" style="padding: 12px 25px; font-size: 15px; font-weight: 600;">Cancel</a>
        </div>
    </form>
</div>