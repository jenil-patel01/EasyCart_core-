@model eays.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="checkout-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <!-- Header -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h2 class="checkout-title"><i class="fa fa-lock"></i> Secure Checkout</h2>
                    <a href="/Cart" class="btn-back"><i class="fa fa-arrow-left me-1"></i> Back to Cart</a>
                </div>

                <!-- Steps -->
                <div class="checkout-steps">
                    <div class="step done">
                        <span class="step-num"><i class="fa fa-check"></i></span> Cart
                    </div>
                    <div class="step-line" style="background:#00b894;"></div>
                    <div class="step active">
                        <span class="step-num">2</span> Checkout
                    </div>
                    <div class="step-line"></div>
                    <div class="step">
                        <span class="step-num">3</span> Confirmation
                    </div>
                </div>

                <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" class="ck-form">
                    @Html.AntiForgeryToken()

                    <div class="row g-4">

                        <!-- LEFT: Billing Details -->
                        <div class="col-lg-7">
                            <div class="ck-card">
                                <h5><i class="fa fa-file-invoice"></i> Billing Details</h5>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Full Name</label>
                                        <div class="input-icon-wrap">
                                            <i class="fa fa-user"></i>
                                            <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                                        </div>
                                        <span asp-validation-for="FullName" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Email Address</label>
                                        <div class="input-icon-wrap">
                                            <i class="fa fa-envelope"></i>
                                            <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Phone <span class="text-danger">*</span></label>
                                        <div class="input-icon-wrap">
                                            <i class="fa fa-phone"></i>
                                            <input asp-for="Phone" class="form-control" placeholder="+91 00000 00000" />
                                        </div>
                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Shipping Address</label>
                                        <div class="input-icon-wrap">
                                            <i class="fa fa-location-dot"></i>
                                            <input asp-for="Address" class="form-control" placeholder="Full address" />
                                        </div>
                                        <span asp-validation-for="Address" class="text-danger"></span>
                                    </div>
                                    
                                    <div class="col-12 mt-4">
                                        <h6 class="fw-bold mb-3"><i class="fa fa-credit-card me-2"></i> Payment Method</h6>
                                        
                                        <label class="payment-method-box bg-light p-3 rounded border mb-2 d-flex align-items-center gap-3 w-100" for="payRazorpay" style="cursor: pointer; transition: all 0.2s;">
                                            <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="RAZORPAY" id="payRazorpay" checked>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fa-solid fa-building-columns text-primary fs-5"></i>
                                                <span class="fw-semibold">Pay with Razorpay (Online)</span>
                                            </div>
                                        </label>
                                        
                                        <label class="payment-method-box bg-light p-3 rounded border d-flex align-items-center gap-3 w-100" for="payCOD" style="cursor: pointer; transition: all 0.2s;">
                                            <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="COD" id="payCOD">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fa-solid fa-money-bill-1-wave text-success fs-5"></i>
                                                <span class="fw-semibold">Cash on Delivery (COD)</span>
                                            </div>
                                        </label>
                                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                                    </div>
                                    
                                </div>

                                
                            </div>
                        </div>

                        <!-- RIGHT: Order Summary -->
                        <div class="col-lg-5">
                            <div class="ck-card">
                                <h5><i class="fa fa-bag-shopping"></i> Order Summary</h5>

                                @foreach (var item in Model.CartItems)
                                {
                                    <div class="cart-item-row">
                                        @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                        {
                                            <img src="@item.Product.ImageUrl" class="cart-item-img"
                                                 alt="@item.Product.Name" />
                                        }
                                        else
                                        {
                                            <div class="cart-item-img-placeholder">
                                                <i class="fa fa-box"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="cart-item-name">@item.Product?.Name</div>
                                            <div class="cart-item-qty">Qty: @item.Quantity &#215; &#8377;@item.Product?.Price.ToString("N2")</div>
                                        </div>
                                        <div class="cart-item-price">
                                            &#8377;@((item.Product?.Price ?? 0 * item.Quantity).ToString("N2"))
                                        </div>
                                    </div>
                                }

                                <div class="mt-3">
                                    <div class="summary-row">
                                        <span>Subtotal (@Model.CartItems.Count items)</span>
                                        <span>&#8377;@Model.Total.ToString("N2")</span>
                                    </div>
                                    <div class="summary-row">
                                        <span>Shipping</span>
                                        <span style="color:#00b894; font-weight:600;">FREE</span>
                                    </div>
                                    <div class="summary-row">
                                        <span>Tax</span>
                                        <span>&#8377;0.00</span>
                                    </div>
                                    <div class="summary-row total">
                                        <span>Total</span>
                                        <span class="summary-val">&#8377;@Model.Total.ToString("N2")</span>
                                    </div>
                                    
                                    <div class="summary-row mt-2" style="padding-top: 10px; border-top: 1px dashed #eee;">
                                        <span style="font-size: 14px; color: #636e72;">Payment Method</span>
                                        <span id="summaryPaymentMethod" style="font-weight: 600; color: #00b894; font-size: 14px;">Online (Razorpay)</span>
                                    </div>
                                   
                                </div>

                                <button type="submit" class="btn-place-order mt-3" id="placeOrderBtn">
                                    <i class="fa fa-lock me-2"></i> Place Order
                                </button>

                                <div class="text-center mt-3">
                                    <small style="color:#b2bec3;">
                                        <i class="fa fa-shield-check me-1"></i> Safe & Secure Checkout
                                    </small>
                                </div>
                            </div>
                        </div>

                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Update summary based on payment method selection
        $('input[name="PaymentMethod"]').on('change', function() {
            var selectedMethod = $(this).val();
            if(selectedMethod === 'COD') {
                $('#summaryPaymentMethod').text('Cash on Delivery');
            } else {
                $('#summaryPaymentMethod').text('Online (Razorpay)');
            }
        });
        
        // Disable button on submit only if the form is valid to prevent double-click
        $('.ck-form').on('submit', function (e) {
            var $form = $(this);
            if ($form.valid()) {
                var btn = document.getElementById('placeOrderBtn');
                btn.disabled = true;
                btn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Processing...';
            }
        });
    </script>
}
