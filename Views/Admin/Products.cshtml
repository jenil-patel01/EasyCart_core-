@model List<Product>
@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
<h2 class="fw-bold mb-0" style="color: #2d3436; margin: 0;">Products</h2>
    
<!-- Search Form -->
<form method="get" asp-action="Products" style="margin: 0; display: flex; align-items: center; gap: 15px;">
    <div style="position: relative;">
        <i class="fa fa-search" style="position: absolute; top: 50%; left: 16px; transform: translateY(-50%); color: #9ca3af; font-size: 15px;"></i>
        <input type="text" name="search" value="@ViewBag.CurrentSearch" placeholder="Search products..." 
               style="width: 320px; padding: 10px 35px 10px 42px; border-radius: 50px; border: 1px solid #e5e7eb; background-color: #f9fafb; font-size: 14px; color: #4b5563; outline: none; transition: all 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.03);"
               onfocus="this.style.backgroundColor='#ffffff'; this.style.borderColor='#d1d5db'; this.style.boxShadow='0 4px 6px rgba(0,0,0,0.05)';"
               onblur="this.style.backgroundColor='#f9fafb'; this.style.borderColor='#e5e7eb'; this.style.boxShadow='0 1px 2px rgba(0,0,0,0.03)';">
        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
        {
            <a href="/Admin/Products" style="position: absolute; top: 50%; right: 14px; transform: translateY(-50%); color: #ef4444; text-decoration: none; font-size: 16px;">
                <i class="fa fa-times-circle"></i>
            </a>
        }
    </div>
    <span style="font-size: 15px; color: #9ca3af; font-weight: 500;">
        @Model.Count product(s)
    </span>
</form>
</div>

<div class="card-table">

    <div class="table-header">
        <h3>All Products</h3>
        <a asp-action="AddProduct" class="btn btn-edit">
            + Add Product
        </a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>
                        <img src="@p.ImageUrl" width="50" style="border-radius:8px;object-fit:cover;height:50px;" />
                    </td>
                    <td><strong>@p.Name</strong></td>
                    <td>
                        @if (p.Category != null)
                        {
                            <span style="background:#f0ebff;color:#6f42c1;padding:3px 10px;border-radius:6px;font-size:12px;font-weight:600;">
                                @p.Category.Name
                            </span>
                        }
                        else
                        {
                            <span style="color:#aaa;font-size:12px;">Uncategorized</span>
                        }
                    </td>
                    <td>&#8377;@p.Price.ToString("N2")</td>
                    <td>@p.Stock</td>
                    <td class="text-end">
                        <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn-edit">Edit</a>
                        <a asp-action="DeleteProduct" asp-route-id="@p.Id" class="btn-del"
                           onclick="return confirm('Delete this product?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>