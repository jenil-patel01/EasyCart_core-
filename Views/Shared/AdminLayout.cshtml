<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Admin</title>

    <link rel="stylesheet" href="~/css/admin.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

@using Microsoft.AspNetCore.Identity
@using eays.Models
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var adminName = currentUser?.FullName ?? currentUser?.UserName ?? "Admin";
    var initial = string.IsNullOrEmpty(adminName) ? "A" : adminName.Substring(0, 1).ToUpper();
}

<body>
    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="logo">🛒 EasyCart</div>

            <nav>
                <a href="/Admin"><i class="fa fa-home"></i> Dashboard</a>
                <a href="/Admin/Products"><i class="fa fa-box"></i> Products</a>
                <a href="/Admin/Categories"><i class="fa fa-tags"></i> Categories</a>
                <a href="/Admin/Users"><i class="fa fa-users"></i> Users</a>
                <a href="/Admin/Orders"><i class="fa fa-bag-shopping"></i> Orders</a>
                <a href="/Admin/Queries"><i class="fa fa-envelope"></i> Queries</a>
                <a href="/Account/Logout"><i class="fa fa-right-from-bracket"></i> Logout</a>
            </nav>
        </aside>

        <!-- MAIN -->
        <div class="main">

            <!-- TOPBAR -->
            <header class="topbar">
                <!-- Empty div to push user profile to the right side because of space-between -->
                <div></div>

                <a href="/Admin/Profile" class="user" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 10px;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #7b1fa2, #512da8); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 18px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                        @initial
                    </div>
                    <span style="font-weight: 600;">@adminName</span>
                </a>
            </header>

            <!-- PAGE -->
            <div class="content">
                @RenderBody()
            </div>

        </div>
    </div>
</body>
</html></html>