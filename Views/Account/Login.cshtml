@model eays.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - EasyCart</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f6fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .login-card {
            background: #ffffff;
            padding: 45px 40px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            width: 100%;
            max-width: 420px;
        }
        .brand-title {
            color: #6c46e3;
            font-weight: 700;
            font-size: 32px;
            text-align: center;
            margin-bottom: 5px;
        }
        .welcome-subtitle {
            color: #4b2aa6;
            font-weight: 600;
            font-size: 20px;
            text-align: center;
            margin-bottom: 35px;
        }
        .form-label {
            color: #7b21ca;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 8px;
        }
        .input-group-custom {
            position: relative;
            margin-bottom: 22px;
        }
        .input-group-custom i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #b7a4de;
            font-size: 15px;
        }
        .input-group-custom input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            border: 1px solid #dfd3f2;
            border-radius: 8px;
            font-size: 14px;
            color: #333;
            background-color: #fdfcff;
            transition: all 0.3s;
        }
        .input-group-custom input::placeholder {
            color: #a9a9a9;
        }
        .input-group-custom input:focus {
            outline: none;
            border-color: #9258f0;
            box-shadow: 0 0 0 3px rgba(146, 88, 240, 0.1);
        }
        .input-group-custom .eye-icon {
            left: auto;
            right: 16px;
            cursor: pointer;
            color: #b7a4de;
        }
        .input-group-custom .eye-icon:hover {
            color: #9258f0;
        }
        .forgot-link {
            color: #9127d1;
            font-size: 13px;
            text-decoration: none;
            font-weight: 600;
        }
        .forgot-link:hover {
            text-decoration: underline;
        }
        .remember-label {
            font-size: 13px;
            color: #4d4d4d;
            margin-left: 2px;
            cursor: pointer;
        }
        .form-check-input {
            cursor: pointer;
            border-color: #999;
        }
        .form-check-input:checked {
            background-color: #9127d1;
            border-color: #9127d1;
        }
        .btn-signin {
            background: linear-gradient(90deg, #9932f5, #5333ea);
            border: none;
            border-radius: 8px;
            padding: 13px;
            color: white;
            font-weight: 600;
            font-size: 15px;
            width: 100%;
            margin-top: 15px;
            margin-bottom: 25px;
            transition: all 0.3s;
        }
        .btn-signin:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(85, 51, 234, 0.25);
        }
        .signup-text {
            text-align: center;
            font-size: 14px;
            color: #333;
        }
        .signup-link {
            color: #5333ea;
            font-weight: 600;
            text-decoration: none;
        }
        .signup-link:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="login-card">
        <div class="brand-title">EasyCart</div>
        <div class="welcome-subtitle">Welcome Back</div>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3" style="font-size: 13px; font-weight: 500;"></div>

            <div class="mb-1">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group-custom">
                    <i class="fa-regular fa-envelope"></i>
                    <input asp-for="Email" placeholder="Enter your email" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger" style="font-size: 12px; position:relative; top:-15px;"></span>
            </div>

            <div class="mb-1">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group-custom">
                    <i class="fa-solid fa-lock"></i>
                    <input asp-for="Password" type="password" id="passwordInput" placeholder="Enter your password" />
                    <i class="fa-regular fa-eye eye-icon" onclick="togglePassword()" id="eyeIcon"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger" style="font-size: 12px; position:relative; top:-15px;"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check mb-0 d-flex align-items-center">
                    <input asp-for="RememberMe" class="form-check-input shadow-none mt-0" type="checkbox" id="rememberMe">
                    <label class="form-check-label remember-label" for="rememberMe">
                        Remember me
                    </label>
                </div>
                <a href="/Account/ForgotPassword" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="btn-signin">Sign In</button>

            <div class="signup-text">
                Don't have an account? <a href="/Account/Register" class="signup-link">Sign up here</a>
            </div>
        </form>
    </div>

    <script>
        function togglePassword() {
            var passInput = document.getElementById("passwordInput");
            var eyeIcon = document.getElementById("eyeIcon");
            
            if (passInput.type === "password") {
                passInput.type = "text";
                eyeIcon.classList.remove("fa-eye");
                eyeIcon.classList.add("fa-eye-slash");
            } else {
                passInput.type = "password";
                eyeIcon.classList.remove("fa-eye-slash");
                eyeIcon.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>