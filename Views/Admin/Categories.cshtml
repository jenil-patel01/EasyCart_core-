@model List<eays.Models.Category>
@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
<h2 class="fw-bold mb-0" style="color: #2d3436; margin: 0;">Categories</h2>
    
<!-- Search Form -->
<form method="get" asp-action="Categories" style="margin: 0; display: flex; align-items: center; gap: 15px;">
    <div style="position: relative;">
        <i class="fa fa-search" style="position: absolute; top: 50%; left: 16px; transform: translateY(-50%); color: #9ca3af; font-size: 15px;"></i>
        <input type="text" name="search" value="@ViewBag.CurrentSearch" placeholder="Search categories..." 
               style="width: 320px; padding: 10px 35px 10px 42px; border-radius: 50px; border: 1px solid #e5e7eb; background-color: #f9fafb; font-size: 14px; color: #4b5563; outline: none; transition: all 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.03);"
               onfocus="this.style.backgroundColor='#ffffff'; this.style.borderColor='#d1d5db'; this.style.boxShadow='0 4px 6px rgba(0,0,0,0.05)';"
               onblur="this.style.backgroundColor='#f9fafb'; this.style.borderColor='#e5e7eb'; this.style.boxShadow='0 1px 2px rgba(0,0,0,0.03)';">
        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
        {
            <a href="/Admin/Categories" style="position-absolute; top: 50%; right: 14px; transform: translateY(-50%); color: #ef4444; text-decoration: none; font-size: 16px;">
                <i class="fa fa-times-circle"></i>
            </a>
        }
    </div>
    <span style="font-size: 15px; color: #9ca3af; font-weight: 500;">
        @Model.Count category(s)
    </span>
</form>
</div>

<div class="card-table">

    <div class="table-header">
        <h3>All Categories</h3>
        <a asp-action="AddCategory" class="btn btn-edit">
            + Add Category
        </a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Icon</th>
                <th>Name</th>
                <th>Products</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>
                        @if (!string.IsNullOrEmpty(c.Icon))
                        {
                            <i class="@c.Icon" style="font-size:18px;color:#7b1fa2;"></i>
                        }
                        else
                        {
                            <i class="fa fa-tag" style="font-size:18px;color:#999;"></i>
                        }
                    </td>
                    <td><strong>@c.Name</strong></td>
                    <td>@c.Products.Count product(s)</td>
                    <td class="text-end">
                        <a asp-action="EditCategory" asp-route-id="@c.Id" class="btn-edit">Edit</a>
                        <a asp-action="DeleteCategory" asp-route-id="@c.Id" class="btn-del"
                           onclick="return confirm('Delete this category? Products will become uncategorized.')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:40px;color:#999;">
            <i class="fa fa-tags" style="font-size:40px;display:block;margin-bottom:12px;"></i>
            <p>No categories yet. Add your first category!</p>
        </div>
    }
</div>
